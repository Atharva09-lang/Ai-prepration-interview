NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:3000
MONGO_URI=mongodb://127.0.0.1:27017/interview-prep-kit
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars


# LLM provider (Google Gemini free tier) — required for real kit generation.
# Get a key at https://aistudio.google.com/app/apikey
# The pipeline always calls Gemini for JD extraction, questions and flashcards.
# If this is blank the run still completes end-to-end (unreachable-site and
# LLM failures are caught per step and recorded honestly in the kit's
# `warnings`), but the generated sections will be thin/empty.
GEMINI_API_KEY=